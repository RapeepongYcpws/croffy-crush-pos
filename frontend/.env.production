# croffy-crush frontend — production defaults.
# Loaded automatically by Next.js during production builds (NODE_ENV=production).
# Only NEXT_PUBLIC_* values belong here — they are PUBLIC, never put secrets here.
# On Vercel you can also set this in Project Settings > Environment Variables (overrides this file).

# Base URL of the deployed backend API, including the /api suffix.
NEXT_PUBLIC_API_BASE_URL=https://croffy-crush-pos.onrender.com/api
