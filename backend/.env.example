# croffy-crush backend configuration.
# Copy to .env for local dev (this file is committed; .env is gitignored).

APP_ENV=development
PORT=8080

# --- Database ---
# Option A: full DSN (recommended for hosted MySQL like Aiven / TiDB).
# Hosted MySQL requires TLS, so append &tls=true.
#   DATABASE_DSN=user:pass@tcp(host:3306)/dbname?charset=utf8mb4&parseTime=true&loc=Local&tls=true
DATABASE_DSN=

# Option B: individual parts (used only when DATABASE_DSN is empty).
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=croffy_crush

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=12

# --- App ---
# In production set this to your frontend origin, e.g. https://croffy-crush.vercel.app
CORS_ORIGIN=http://localhost:3000
PROMPTPAY_ID=0812345678
POINTS_PER_BAHT=10
